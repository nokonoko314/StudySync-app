<?xml version="1.0" encoding="utf-8"?>
<!-- ウィジェット「今日の進み具合」(小) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/widget_background" android:padding="12dp">

    <TextView android:id="@+id/w_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="今日" android:textColor="#8C95A6" android:textSize="12sp" android:textStyle="bold" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp">
        <ImageView android:id="@+id/w_ring" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:adjustViewBounds="true" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/w_ring_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#EEF1F6" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_ring_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="完了" android:textColor="#8C95A6" android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_studied" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#EEF1F6" android:textSize="11sp" android:maxLines="1" />
        <TextView android:id="@+id/w_reviews" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#4FC3E0" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
