<?xml version="1.0" encoding="utf-8"?>
<!-- ウィジェット「次の予定」(小) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background" android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="5dp"
            android:src="@drawable/widget_mark" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="次の予定" android:textColor="#8C95A6" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8C95A6" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="bottom">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="8dp">
                <ImageView android:id="@+id/w_avatar_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_avatar" android:importantForAccessibility="no" />
                <TextView android:id="@+id/w_avatar" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            </FrameLayout>
            <TextView android:id="@+id/w_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#4FC3E0" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" />
        </LinearLayout>
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textColor="#EEF1F6" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/w_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:textColor="#8C95A6" android:textSize="12sp" />
    </LinearLayout>

    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:textColor="#8C95A6" android:textSize="13sp" android:visibility="gone"
        android:text="アプリを開くと予定が表示されます" />
</LinearLayout>
